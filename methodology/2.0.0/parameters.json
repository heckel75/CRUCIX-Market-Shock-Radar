{
  "methodologyVersion": "2.0.0",
  "schemaVersion": "crucix-methodology-parameters/v1",
  "status": "corrected-freeze-candidate-awaiting-fresh-pa08",
  "parameters": {
    "canonicalization": {
      "canonicalizationVersion": "crucix-canonical-json/v2.0.0",
      "algorithm": [
        "Remove only fields named in volatileFieldsExcludedFromIdentity before canonical identity is computed.",
        "Reject non-finite numbers and sequence-like arrays that violate their monotonic order rule.",
        "Normalize negative zero to positive zero; retain null and typed assessment objects without coercion.",
        "Recursively canonicalize values. Sort object keys lexicographically by JavaScript UTF-16 code units.",
        "For set-like arrays, canonicalize each element and sort by the declared key; reject duplicate canonical keys. For sequence-like arrays, preserve validated order and never silently sort.",
        "Serialize with ECMAScript JSON.stringify and no insignificant whitespace, append exactly one LF byte, encode the resulting string as UTF-8, and hash those bytes with SHA-256."
      ],
      "encoding": "UTF-8 without BOM",
      "objectKeyOrdering": "ascending JavaScript UTF-16 code-unit order",
      "insignificantWhitespace": "none",
      "finalNewline": "exactly one LF byte",
      "numberSerialization": "ECMAScript JSON.stringify after persisted-output rounding; non-finite values prohibited",
      "negativeZero": "normalize to numeric zero before serialization",
      "nullHandling": "retain explicit null; never omit or coerce it",
      "typedUnknownHandling": "retain the complete assessment wrapper including status, reason, reliability where applicable, and evidenceRefs",
      "volatileFieldsExcludedFromIdentity": [
        "generatedAt",
        "renderedAt",
        "validationExecutedAt"
      ],
      "computedDecimalPlaces": 12,
      "computedRounding": "ECMAScript Number.prototype.toFixed followed by numeric parsing; applied only at persisted-output boundary, never during intermediate calculation",
      "displayDecimalPlaces": 3,
      "hashAlgorithm": "sha256",
      "hashHexCase": "lowercase",
      "lineEnding": "LF",
      "timestampFormat": "RFC3339 UTC with exactly three fractional digits",
      "arrayPolicyDefault": "prohibited-unless-declared",
      "arrayPoliciesByProperty": {
        "aliases": { "kind": "set", "sortKey": "aliasId" },
        "artifactAndEvidenceIdentities": { "kind": "set", "sortKey": "path" },
        "assignments": { "kind": "sequence", "monotonicKey": "decidedAt ascending, then assignmentVersion strictly ascending, then assignmentId ascending" },
        "cases": { "kind": "sequence", "monotonicKey": "authored order; fixture IDs must be unique" },
        "candidateIds": { "kind": "set", "sortKey": "lexical value" },
        "candidates": { "kind": "set", "sortKey": "candidateId" },
        "channels": { "kind": "set", "sortKey": "channelId" },
        "configurationArtifacts": { "kind": "set", "sortKey": "path" },
        "configurationHashes": { "kind": "set", "sortKey": "lexical value" },
        "correctionHistory": { "kind": "sequence", "monotonicKey": "effectiveAt ascending, then provenanceId ascending" },
        "derivedCandidateIds": { "kind": "set", "sortKey": "lexical value" },
        "diagnostics": { "kind": "set", "sortKey": "diagnosticId" },
        "directMechanismIds": { "kind": "set", "sortKey": "lexical value" },
        "eventClusterIds": { "kind": "set", "sortKey": "lexical value" },
        "eventClusters": { "kind": "set", "sortKey": "eventClusterId" },
        "evidenceRefs": { "kind": "set", "sortKey": "lexical value" },
        "excludedInstrumentIds": { "kind": "set", "sortKey": "lexical value" },
        "exclusionReasons": { "kind": "set", "sortKey": "lexical value" },
        "independenceGroupIds": { "kind": "set", "sortKey": "lexical value" },
        "independenceGroups": { "kind": "set", "sortKey": "independenceGroupId" },
        "includedInstrumentReadings": { "kind": "set", "sortKey": "instrumentId" },
        "inputArtifacts": { "kind": "set", "sortKey": "path" },
        "inputHashes": { "kind": "set", "sortKey": "lexical value" },
        "instrumentObservationDates": { "kind": "sequence", "monotonicKey": "date strictly ascending" },
        "instruments": { "kind": "set", "sortKey": "instrumentId" },
        "lifecycleHistory": { "kind": "sequence", "monotonicKey": "effectiveAt ascending, then transitionVersion strictly ascending" },
        "lineage": { "kind": "sequence", "monotonicKey": "decidedAt ascending, then provenanceId ascending" },
        "mechanisms": { "kind": "set", "sortKey": "mechanismId" },
        "memberOriginIds": { "kind": "set", "sortKey": "lexical value" },
        "originEvidenceHistory": { "kind": "sequence", "monotonicKey": "effectiveAt ascending, then assessmentVersion strictly ascending" },
        "originProvenance": { "kind": "set", "sortKey": "candidateId" },
        "originatingAssertionIds": { "kind": "set", "sortKey": "lexical value" },
        "originatingAssertions": { "kind": "set", "sortKey": "assertionId" },
        "origins": { "kind": "set", "sortKey": "reportingOriginId" },
        "outputArtifacts": { "kind": "set", "sortKey": "path" },
        "parentSeries": { "kind": "set", "sortKey": "parentSeriesId" },
        "parentSeriesIds": { "kind": "set", "sortKey": "lexical value" },
        "provenanceEdges": { "kind": "set", "sortKey": "provenanceEdgeId" },
        "provenanceEdgeIds": { "kind": "set", "sortKey": "lexical value" },
        "provenanceIds": { "kind": "set", "sortKey": "lexical value" },
        "qualifyingClusterIds": { "kind": "set", "sortKey": "lexical value" },
        "rankedClusters": { "kind": "sequence", "monotonicKey": "rank ascending, then eventClusterId ascending" },
        "reasonCodes": { "kind": "set", "sortKey": "lexical value" },
        "reportingOriginIds": { "kind": "set", "sortKey": "lexical value" },
        "reportingOrigins": { "kind": "set", "sortKey": "reportingOriginId" },
        "reportingSourceIds": { "kind": "set", "sortKey": "lexical value" },
        "reportingSources": { "kind": "set", "sortKey": "reportingSourceId" },
        "resultIds": { "kind": "set", "sortKey": "lexical value" },
        "specificOriginIds": { "kind": "set", "sortKey": "lexical value" },
        "subjectIds": { "kind": "set", "sortKey": "lexical value" },
        "supersedesParentSeriesIds": { "kind": "set", "sortKey": "lexical value" },
        "visibleNonElevatingClusterIds": { "kind": "set", "sortKey": "lexical value" },
        "warnings": { "kind": "set", "sortKey": "lexical value" },
        "weekdayNumbersIncludedUtc": { "kind": "set", "sortKey": "numeric ascending" }
      }
    },
    "identity": {
      "contentHashHexLength": 64,
      "opaqueIdDigestPrefixHexLength": 20,
      "runIdFormat": "run-YYYYMMDDTHHMMSSmmmZ-{first20hex(canonical-run-input-manifest-sha256)}",
      "candidateIdFormat": "cand-sha256-{64hex}",
      "assignmentIdFormat": "asn-sha256-{64hex}",
      "eventClusterIdFormat": "evt-YYYYMMDDTHHMMSSmmmZ-{first20hex(canonical-creation-record-sha256)}",
      "parentSeriesIdFormat": "series-YYYYMMDDTHHMMSSmmmZ-{first20hex(canonical-creation-record-sha256)}",
      "provenanceIdFormat": "prov-sha256-{64hex}"
    },
    "signal": {
      "selectedEvidenceFamily": "E2-resolved-single-or-independent",
      "minimumIndependentOriginsForCorroboration": 2,
      "minimumQualifyingActionStageOrdinal": 3,
      "actionStageOrdinals": {
        "rhetoric-or-threatened": 1,
        "announced": 2,
        "implemented": 3,
        "impact-observed": 4
      },
      "qualifyingLifecycleStates": [
        "new",
        "escalating",
        "de-escalating"
      ],
      "maximumClusterContributionPerChannelPerRun": 1,
      "rankingKeys": [
        "actionStageOrdinal:descending",
        "eventClusterId:ascending"
      ],
      "scalarSignalScore": null
    },
    "market": {
      "transformLookbackValidObservations": 5,
      "zHistoryValidTransformsMinimum": 252,
      "zHistoryValidTransformsMaximum": 252,
      "sampleStandardDeviationDegreesOfFreedomAdjustment": 1,
      "sameDateMaximumGapBusinessDays": 0,
      "freshnessMaximumBusinessDays": 3,
      "weekdayNumbersIncludedUtc": [
        1,
        2,
        3,
        4,
        5
      ],
      "minimumEligibleInstrumentCountByMappedCount": {
        "2": 2,
        "3": 2,
        "4": 3
      },
      "marketStatistic": "maximum-absolute-own-series-z",
      "diagnosticRawZThreshold": 1.5,
      "percentileAlpha": 0.2,
      "percentileQuantile": 0.8,
      "percentileMinimumConditionedPriorObservations": 126,
      "percentileRollingPriorObservationMaximum": 252,
      "percentileRankFormula": "max(1,ceil((1-alpha)*n))",
      "percentileComparison": "strictly-greater-than",
      "marketCloseLocalTime": "16:00:00",
      "marketCloseTimeZone": "America/New_York",
      "afterCloseDeferralEligibleCloses": 1,
      "breadthBinaryWeight": 0
    },
    "parallelAcceptance": {
      "minimumDistinctEligibleMarketCloses": 30,
      "requiredIndependentPostFreezeValidationPasses": 1,
      "allowedUnexplainedDeterminismFailures": 0,
      "allowedForbiddenPathChanges": 0,
      "allowedUnrecordedAmbiguousAssignments": 0
    }
  },
  "nonNumericRules": {
    "calendar": "Age is counted from the observation date exclusive to the evaluation date inclusive over UTC Monday through Friday. Weekends are excluded; holidays and early closes are not inferred because no complete versioned exchange calendar was frozen.",
    "sourceAvailability": "A date-only or unreliable availability timestamp is typed unknown. It is never treated as before-close.",
    "historyFallback": "No cross-set, cross-count, expanding, pooled, or raw-threshold fallback is permitted when conditioned percentile history is insufficient.",
    "ties": "A value equal to the percentile threshold is not elevated. Driver ties use ascending instrumentId only to make output deterministic and expose the tied IDs.",
    "breadth": "Breadth is diagnostic and has zero weight in the binary market assessment.",
    "decay": "There is no time-decay, stale-event, expiry, or inferred de-escalation parameter in 2.0.0."
  }
}
